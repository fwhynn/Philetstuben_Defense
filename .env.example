# Optional: route client API requests through the local development server.
# Without a local .env file, the client continues to use the production API.
API_BASE_URL=http://127.0.0.1:8081

# Shared with the API .env DUO_LIVE_SECRET. Required for admin Duo live metrics.
DUO_LIVE_SECRET=replace-with-at-least-32-random-bytes
