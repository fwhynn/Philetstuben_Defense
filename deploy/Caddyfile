autohextd.zlyfer.net {
  encode zstd gzip
  header {
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
  }
  @duo path /state /command /session /results /healthz /lobby/*
  handle @duo {
    reverse_proxy duo:8090
  }
  handle {
    root * /srv/site
    header Cache-Control no-cache
    file_server
  }
}
