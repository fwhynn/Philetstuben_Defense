autohextd.autophil.lol {
  encode zstd gzip
  header {
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
  }
  @duo path /state /command /session /results /healthz /visit /visits /lobby/* /socket.io/*
  handle @duo {
    reverse_proxy duo:8090 {
      header_up X-Real-IP {remote_host}
    }
  }
  handle {
    root * /srv/site
    header Cache-Control no-cache
    file_server
  }
}
